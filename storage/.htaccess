# =============================================================================
# CURRÍCULOS E LOGS — NUNCA PELA WEB
# =============================================================================
# storage/app/private/resumes/ guarda currículo de candidato, que é dado
# pessoal. storage/logs/ guarda rastro de erro.
#
# Como a raiz do projeto fica fora do Document Root, esta pasta já é
# inalcançável. Isto é a segunda barreira, para o caso de a primeira falhar —
# inclusive num link simbólico criado por engano dentro de public/.
# =============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
