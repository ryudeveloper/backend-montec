APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Montec — formulários públicos
# =============================================================================

# Destinatários. Ficha da empresa no CLAUDE.md do frontend.
MONTEC_MAIL_SALES=contato@montecmococa.com.br
MONTEC_MAIL_CAREERS=vagas@montecmococa.com.br
# Caixa própria: o conteúdo é sensível e o acesso deve ser restrito.
MONTEC_MAIL_WHISTLEBLOWER=ouvidoria@montecmococa.com.br

# Origens autorizadas a chamar /api/* (separadas por vírgula).
# NUNCA use "*": qualquer site poderia postar nos formulários usando o
# navegador do visitante como ponte.
MONTEC_CORS_ORIGINS=https://www.montecmococa.com.br

# Currículo — 5 MB. Validado aqui e no client; client é UX, servidor é segurança.
MONTEC_RESUME_MAX_BYTES=5242880
# Disco privado, fora do webroot. Ver config/filesystems.php.
MONTEC_RESUME_DISK=resumes

# Rate limit em duas camadas, por origem: por endpoint e somando os três.
# Só o global bloquearia quem manda um contato e depois um currículo; só o por
# rota deixaria um bot varrer os três somando o triplo de tentativas.
MONTEC_RATE_LIMIT_PER_MINUTE=5
MONTEC_RATE_LIMIT_GLOBAL_PER_MINUTE=8

# Cloudflare Turnstile. Preencher LIGA a verificação nos três formulários;
# vazio a desliga por completo. Só o segredo entra aqui — a site key é do
# frontend (VITE_TURNSTILE_SITE_KEY).
MONTEC_TURNSTILE_SECRET=

# Retenção LGPD, em dias. O expurgo roda diariamente (montec:purge-expired).
MONTEC_RETENTION_CONTACT_DAYS=365
MONTEC_RETENTION_JOB_DAYS=365
MONTEC_RETENTION_WHISTLEBLOWER_DAYS=1825

# --- Triagem de currículo por IA (opcional) --------------------------------
# Preencher LIGA a triagem; vazio a desliga por completo e o botão nem aparece.
#
# O parecer é CONSULTIVO: informa o RH e nunca reprova. Art. 20 da LGPD dá ao
# candidato direito de revisão de decisão tomada unicamente por processamento
# automatizado.
#
# ANTES DE LIGAR: enviar currículo a terceiro é tratamento de dado pessoal e
# precisa estar declarado na política de privacidade do site.
#
# O texto vai REDIGIDO — nome, e-mail, telefone, CPF, RG e idade são removidos
# antes do envio, para o modelo não correlacionar o que não tem a ver com a vaga.
# MONTEC_AI_KEY=
# MONTEC_AI_MODEL=claude-sonnet-5
# MONTEC_AI_MAX_CHARS=18000

# --- Portal interno -------------------------------------------------------
# Contas são criadas por comando, nunca por formulário. Papéis: hr, ombudsman,
# admin — acumuláveis por vírgula. Separação de deveres: `hr` não vê denúncia,
# `ombudsman` não vê currículo, e `admin` não vê nenhum dos dois (administra
# contas, não lê conteúdo).
#   php artisan montec:create-user rh@montecmococa.com.br --name="Maria" --roles=hr
#   php artisan montec:create-user ouv@montecmococa.com.br --name="Paulo" --roles=ombudsman
#
# Sessão: `secure` liga sozinho quando APP_ENV=production, e SameSite=strict é o
# padrão. Só sobrescreva se souber o motivo.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=strict
